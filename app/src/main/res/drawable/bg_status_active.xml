<?xml version="1.0" encoding="utf-8"?>
<!-- 呼吸脉冲环：状态运行时在图标外扩散 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/pulse_ring">
        <shape android:shape="oval">
            <solid android:color="#00FFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
    <item
        android:id="@+id/pulse_dot"
        android:bottom="22dp"
        android:left="22dp"
        android:right="22dp"
        android:top="22dp">
        <shape android:shape="oval">
            <solid android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
