<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 顶部搜索 + 筛选 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <!-- 胶囊搜索栏 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchBox"
            style="@style/Widget.DnsOverride.SearchField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="?attr/colorOnSurfaceVariant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/rules_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 类型筛选 Chip -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/rules_filter_all"
                    app:chipCornerRadius="@dimen/radius_pill" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOverride"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rules_filter_override"
                    app:chipCornerRadius="@dimen/radius_pill" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBlock"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rules_filter_block"
                    app:chipCornerRadius="@dimen/radius_pill" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDirect"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rules_filter_direct"
                    app:chipCornerRadius="@dimen/radius_pill" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- 当前编辑组提示 + 切换组 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.DnsOverride.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_xs"
            app:cardCornerRadius="@dimen/radius_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_xxs"
                android:paddingEnd="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xxs">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:src="@drawable/ic_nav_rules"
                    app:tint="?attr/colorPrimary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/textActiveGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.DnsOverride.Caption"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="正在编辑：默认规则组（12 条）" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchGroup"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rules_switch_group" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 冲突提示条 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardConflicts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_xs"
        app:cardBackgroundColor="@color/brand_tertiary_12"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="0dp"
        app:strokeColor="@color/warning"
        app:strokeWidth="1dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:src="@drawable/ic_warning"
                app:tint="@color/warning"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/textConflictSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.DnsOverride.Body"
                android:textColor="?attr/colorOnSurface"
                tools:text="检测到 3 处规则冲突" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConflictDetail"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_confirm" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listRules"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_xs"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="96dp" />

        <!-- 空态：区分「组为空」与「筛选后为空」，并提供对应引导按钮 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_xxl"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_card">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_rule_empty"
                    app:tint="?attr/colorOnSurfaceVariant"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <TextView
                android:id="@+id/textEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/rules_empty"
                android:textAppearance="@style/TextAppearance.DnsOverride.Body"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/rules_empty_add"
                app:icon="@drawable/ic_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyClearFilter"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/rules_empty_clear_filter"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="@dimen/space_md"
            android:contentDescription="@string/action_add"
            android:src="@drawable/ic_add"
            android:backgroundTint="?attr/colorPrimary"
            app:tint="@color/brand_on_primary"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.DnsOverride.Medium" />
    </FrameLayout>

    <!-- 多选批量操作栏：默认隐藏，浮起胶囊样式 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/batchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_sm"
        app:cardCornerRadius="@dimen/radius_pill"
        app:cardElevation="6dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs">

            <ImageView
                android:id="@+id/imgSelectAll"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_select_all"
                android:src="@drawable/ic_check_circle"
                android:scaleType="center"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/textSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.DnsOverride.Title"
                tools:text="已选 3 项" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatchToggle"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rules_toggle_selected" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatchDelete"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rules_delete_selected"
                android:textColor="@color/danger" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatchClear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rules_clear_selection" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
