# 复制为 keystore.properties 后填入真实值（该文件已在 .gitignore 中，切勿提交）
#
# 生成 keystore：
#   keytool -genkey -v -keystore release.keystore \
#     -alias dns_override -keyalg RSA -keysize 2048 -validity 10950
#
# CI 中建议改用以下环境变量（见 .github/workflows/release.yml），不要提交文件：
#   DNSOVERRIDE_STORE_FILE       keystore 文件路径
#   DNSOVERRIDE_STORE_PASSWORD   keystore 口令
#   DNSOVERRIDE_KEY_ALIAS        密钥别名
#   DNSOVERRIDE_KEY_PASSWORD     密钥口令

DNSOVERRIDE_STORE_FILE=release.keystore
DNSOVERRIDE_STORE_PASSWORD=
DNSOVERRIDE_KEY_ALIAS=dns_override
DNSOVERRIDE_KEY_PASSWORD=
