# EditorConfig —— 跨 IDE 统一基础格式
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin / Java：Android Studio 默认风格
[*.{kt,kts,java}]
indent_size = 4
max_line_length = 120
ij_kotlin_name_count_to_use_star_import = 99
ij_kotlin_name_count_to_use_star_import_for_members = 99

# XML / 资源文件
[*.xml]
indent_size = 4
# Android 资源文件用 4 空格，但 manifest 内属性不强制换行
[{AndroidManifest.xml}]
indent_size = 4

# Gradle 脚本
[*.gradle.kts]
indent_size = 4

# 文档
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# 脚本与 CI
[*.{sh,yml,yaml}]
indent_size = 2

[*.{properties,toml}]
indent_size = 2

[gradlew.bat]
end_of_line = crlf
